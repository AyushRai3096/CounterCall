# Relay server WebSocket URL. The relay runs on this same counter PC
# (see the root README), so localhost is correct.
RELAY_URL=http://localhost:4000

# Name of the kitchen thermal printer exactly as Windows lists it
# (Settings > Printers & scanners). Tickets are printed as HTML through
# the normal Windows printer driver, not ESC/POS.
PRINTER_NAME=RP80

# Copies of every ticket. Default 1.
# PRINT_COPIES=1

# Only if auto-detection fails: full paths to Microsoft Edge and SumatraPDF.
# EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe

# Dev mode replaces the real printer with a browser preview at
# http://localhost:4100 showing the exact ticket with Accept/Reject
# buttons, so you can test both the successful-print and failed-print
# paths without hardware.
#
# DEFAULT IS OFF (real printer). Only set this to true on a development
# machine that has no printer attached. On the real counter PC, leave
# this unset or false — there is no UI in production, the printer just
# prints.
DEV_MODE=true
DEV_PREVIEW_PORT=4100
