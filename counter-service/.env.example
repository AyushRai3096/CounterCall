# Relay server WebSocket URL. The relay runs on this same counter PC
# (see the root README), so localhost is correct — do not change this
# to a LAN IP unless the relay is later moved to a separate machine.
RELAY_URL=http://localhost:4000

# node-thermal-printer type: epson | star | tanca | daruma
PRINTER_TYPE=epson

# Printer interface. Examples:
#   USB (via driver share name on Windows): printer:EPSON_TM_T20
#   Network:                                 tcp://192.168.1.50:9100
#   Raw USB path (linux):                     /dev/usb/lp0
PRINTER_INTERFACE=tcp://192.168.1.50:9100

# Restaurant name printed on the ticket header
RESTAURANT_NAME=CounterCall

# Dev mode replaces the real printer with a browser preview at
# http://localhost:4100 with Accept/Reject buttons, so you can test both
# the successful-print and failed-print paths without hardware.
#
# DEFAULT IS OFF (real printer). Only set this to true on a development
# machine that has no printer attached. On the real counter PC, leave
# this unset or false — there is no UI in production, the printer just
# prints.
DEV_MODE=true
DEV_PREVIEW_PORT=4100
